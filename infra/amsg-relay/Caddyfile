# /etc/caddy/Caddyfile（中转机，只跑主动消息 2.0 中转）—— 设计与取舍见 docs/amsg2-relay.md
# 域名必须在 Cloudflare 上是灰云 / DNS only：走橙云的话流量又绕回 CF，中转就白做了。
{
	admin off

	# 运行时日志（不是访问日志）整体丢弃：error 级日志会带上 TLS 握手失败方的 IP。
	# 排障时临时改成 `output stderr`，排障后改回。
	log {
		output discard
	}
}

# 站点里刻意不写日志指令：Caddy 默认不记访问日志，运行时日志已由上方全局块丢弃。
# 令牌、路径白名单、限流、流量记录和「只连 Cloudflare」都在本机的中转服务里（relay.py），
# 这里只管 HTTPS 和几道粗筛。
amsg-relay.friedsully.com {
	header -Server

	# 最大的单个请求是 client-state 同步，实测约 800KB，留足余量
	request_body {
		max_size 10MB
	}

	# 只认带令牌的地址，并拒绝 WebSocket 升级（翻墙 Worker 最常见的走法）
	@amsg_relay {
		method GET POST PUT DELETE OPTIONS
		path /t/*
		not header Upgrade *
	}

	handle @amsg_relay {
		reverse_proxy 127.0.0.1:8787 {
			# 中转服务本身也不看用户 IP：在这一跳就去掉，它和 Worker 都拿不到
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -X-Real-IP
			header_up -Forwarded
			flush_interval -1
		}
	}

	handle {
		respond 404
	}
}
